# DadFit Instagram Publish Credentials
# ── Copy this file to publish_config.env and fill in your values ──────────────
# NEVER commit publish_config.env to git.

# Your Instagram professional account's numeric ID
# Find it in: Graph API Explorer → select your app → GET /me?fields=id
IG_USER_ID=YOUR_INSTAGRAM_USER_ID_HERE

# Long-lived access token with permissions:
#   instagram_basic, instagram_content_publish, pages_read_engagement
# Generate at: https://developers.facebook.com/tools/explorer/
IG_ACCESS_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN_HERE

# Meta Graph API version (update when Meta deprecates old versions)
IG_API_VERSION=v25.0
